# Account Silo runs as. It must be able to read /media/external/media, the
# library shared with Jellyfin. Check with: ls -ln /media/external/media
# 997-999 are reserved for the bundled PostgreSQL, Redis and Meilisearch.
PUID=1000
PGID=1000

# Master key for Silo's at-rest credential encryption (it encrypts the
# Authentik client secret, among others). Silo refuses to start without it.
# Paste the OUTPUT of:  openssl rand -base64 48  (at least 32 chars; compose
# does not run $(...) in this file).
# Keep a copy OUTSIDE the backups of this directory, and never change it on an
# existing install: a lost key makes every encrypted secret unrecoverable.
SECRET_KEY=changeme

# Optional: pin an image build instead of following latest.
# SILO_IMAGE=ghcr.io/silo-server/silo-server:build-N
