# Samba account allowed to access the share. The container account, its UID
# and the share's "valid users" are all derived from this name.
SMB_USER=paolo

# Password for SMB_USER - the sole credential protecting the share.
# Set a real value before the first run.
SMB_PASSWORD=changeme

# Host directory holding the photo library, bind-mounted as the [photos] share.
# This must be the real mount point of the external drive - see README.
SMB_PHOTOS_DIR=/media/external/photos

# UID owning SMB_PHOTOS_DIR on the host. The container account is created with
# this UID so files written over SMB are owned correctly on the host.
SMB_UID=1000

# Port on the host system that SMB should be published on.
SMB_HOST_PORT=445
