# Title shown in the AgenDAV header and the browser tab.
AGENDAV_SITE_TITLE="Calendar"

# Timezone applied to new users, matching the other stacks in this repo.
AGENDAV_TIMEZONE="Europe/Rome"

# Public origin of the OpenCloud instance serving CalDAV, with NO trailing
# slash. Only used to display per-calendar URLs in the UI, which AgenDAV builds
# by concatenating this with the collection's absolute path. Should match
# OPENCLOUD_FQDN in opencloud/.env.
OPENCLOUD_FQDN="https://opencloud.example.com"

# Per-installation secrets. Generate each with:
#     openssl rand -hex 32
#
# AGENDAV_CSRF_SECRET protects the login form. AGENDAV_SESSION_KEY encrypts the
# OpenCloud app token stored in every session, so treat it like a password.
# init.sh refuses to start while either is still "changeme".
AGENDAV_CSRF_SECRET="changeme"
AGENDAV_SESSION_KEY="changeme"
