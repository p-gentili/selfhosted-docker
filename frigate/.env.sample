# Tapo C210. In the Tapo app: camera > Settings > Advanced Settings > Camera
# Account. This account is separate from your TP-Link login; it is used for
# both the RTSP video streams and ONVIF pan/tilt.
# Any symbol except $ (compose rewrites it); init.sh URL-encodes it for the
# streams. FRIGATE_MQTT_PASSWORD: letters and digits only.
FRIGATE_TAPO_HOST=192.168.68.x
FRIGATE_TAPO_USER=frigate
FRIGATE_TAPO_PASSWORD=changeme

# The frigate account from ../mosquitto/.env (MQTT_USER_frigate).
FRIGATE_MQTT_USER=frigate
FRIGATE_MQTT_PASSWORD=changeme
