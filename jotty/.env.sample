# Public hostname is notes.$DOMAIN (APP_URL is built from it in the compose file).
DOMAIN=home.example.com

# Account the container runs as; init.sh chowns ./data ./config ./cache to it.
PUID=1000
PGID=1000

# Sign-in with Authentik (see README). Comment out AUTH_MODE to use local
# accounts only.
AUTH_MODE=oidc
# Trailing slash required.
OIDC_ISSUER=https://auth.home.example.com/application/o/jotty/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Keep the local login as a break-glass when Authentik is down.
SSO_FALLBACK_LOCAL=yes
# Authentik sends `groups` with the profile scope; it has no `groups` scope.
OIDC_GROUPS_SCOPE=no
# Members of this Authentik group become Jotty admins.
OIDC_ADMIN_GROUPS=authentik Admins
# Optional: only these groups may sign in (admins always can).
# OIDC_USER_GROUPS=jotty_users
